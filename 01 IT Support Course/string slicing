mystring = "Welcome to Ameer"
print(
    mystring[0:7]
)  # * String splicing; extracts a portion of a string or work with a part of it
# * Note that It starts from '0' up to but not including the end (e.g. "7")

mystring2 = "Random is key to victory"
print(
    mystring2[0:13:2]
)  # * By added 'Step' perimeter; this example shows that it extracted from 0 (R) to 13 (before space; y "non-inclusive") and the counts ever two character as one

random = "Hello"
print(random[0:5:2])

print(random[::-1])  # * the "-1" is an inverse of "Step" perimeter.
